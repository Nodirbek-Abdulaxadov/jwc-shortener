namespace routes.site;

import middleware.metrics;

--- The landing page is a file. So are the OG image and the OpenAPI
--- document; `static "/" from "public"` serves all three, and under
--- `jwc build` they are walked at compile time and `include_bytes!`d into
--- the binary (routing.md §10.6), so the image needs no directory beside
--- it in the container.
---
--- Until this port the landing page was 360 lines of `+ "\n"` string
--- concatenation inside a `views.pages` function, because 0.9's HTML lived
--- in a `r"..."` literal and 1.0 has no multi-line string. Neither form
--- was the right one: it is a file, it never changes per request, and as a
--- file it gets an ETag, a 304 and a `Cache-Control` for free.
static "/" from "public" cache 3600;

--- What the mount cannot answer.
---
--- routing.md §10.2 puts every `route` ahead of a `static` mount, and
--- `/{code: text}` is a route — so `/robots.txt` reaches the redirect
--- handler, finds no such link and 404s. §4.2 *does* hold between routes,
--- so a literal route beats the catch-all, and that is what these are.
--- (Compare config.md §4.0.3, which says a declared route wins the
--- operational names only when the path was *written*: a slot does not
--- take `/healthz`. §10.2 does not extend the same courtesy to a mount.)
---
--- `/assets/og.svg` and `/assets/openapi.json` need none of this — two
--- segments against the slot route's one — which is why the files live
--- under `assets/` and only the fixed crawler names are routes.
routes "/" use MetricsTracker {
    route GET "robots.txt" {
        return content("text/plain; charset=utf-8", string.join([
            "User-agent: *",
            "Allow: /",
            "Disallow: /api/",
            "",
            "Sitemap: https://1kb.uz/sitemap.xml",
            ""
        ], "\n"));
    }

    route GET "sitemap.xml" {
        return content("application/xml; charset=utf-8", string.join([
            r"<?xml version='1.0' encoding='UTF-8'?>",
            r"<urlset xmlns='http://www.sitemaps.org/schemas/sitemap/0.9'>",
            r"  <url>",
            r"    <loc>https://1kb.uz/</loc>",
            r"    <changefreq>weekly</changefreq>",
            r"    <priority>1.0</priority>",
            r"  </url>",
            r"  <url>",
            r"    <loc>https://1kb.uz/docs</loc>",
            r"    <changefreq>monthly</changefreq>",
            r"    <priority>0.5</priority>",
            r"  </url>",
            r"</urlset>",
            ""
        ], "\n"));
    }

    --- The two URLs the 0.9 service published, kept working.
    ---
    --- Both moved under `/assets/` so the mount can serve them; a 301 is
    --- what tells a social scraper with a cached card, or a client with a
    --- saved OpenAPI URL, where the document went.
    route GET "og.svg" {
        return redirect(301, "/assets/og.svg");
    }

    route GET "openapi.json" {
        return redirect(301, "/assets/openapi.json");
    }

    --- Swagger UI over the document `jwc openapi` writes.
    ---
    --- The 0.9 page carried the OpenAPI as one hand-written 2 KB JSON
    --- string literal, which described the route table at the moment
    --- somebody last edited it. `jwc openapi` derives it from the typed
    --- signatures, so `make openapi` is the only thing that has to be run
    --- and there is no second description to drift.
    route GET "docs" {
        return content("text/html; charset=utf-8", string.join([
            r"<!DOCTYPE html>",
            r"<html lang='en'>",
            r"<head>",
            r"<meta charset='utf-8'>",
            r"<meta name='viewport' content='width=device-width, initial-scale=1'>",
            r"<title>1kb.uz API Reference — Interactive Docs (Swagger UI)</title>",
            r"<meta name='description' content='Interactive OpenAPI reference for the 1kb.uz URL shortener API: create short links, resolve codes, and read live traffic stats.'>",
            r"<link rel='canonical' href='https://1kb.uz/docs'>",
            r"<meta name='theme-color' content='#0b0d10'>",
            r"<link rel='icon' type='image/svg+xml' href='/assets/og.svg'>",
            r"<meta property='og:type' content='website'>",
            r"<meta property='og:site_name' content='1kb.uz'>",
            r"<meta property='og:title' content='1kb.uz API Reference'>",
            r"<meta property='og:description' content='Interactive OpenAPI reference for the 1kb.uz URL shortener API.'>",
            r"<meta property='og:url' content='https://1kb.uz/docs'>",
            r"<meta property='og:image' content='https://1kb.uz/assets/og.svg'>",
            r"<link rel='stylesheet' href='https://unpkg.com/swagger-ui-dist@5/swagger-ui.css'>",
            r"<style>body { margin: 0; }</style>",
            r"</head>",
            r"<body>",
            r"<div id='swagger-ui'></div>",
            r"<script src='https://unpkg.com/swagger-ui-dist@5/swagger-ui-bundle.js'></script>",
            r"<script>",
            r"window.onload = function () {",
            r"  window.ui = SwaggerUIBundle({",
            r"    url: '/assets/openapi.json',",
            r"    dom_id: '#swagger-ui',",
            r"    deepLinking: true,",
            r"    presets: [SwaggerUIBundle.presets.apis],",
            r"    layout: 'BaseLayout'",
            r"  });",
            r"};",
            r"</script>",
            r"</body>",
            r"</html>",
            ""
        ], "\n"));
    }
}
