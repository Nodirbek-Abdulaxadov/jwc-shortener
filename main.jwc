// jwc-shortener — URL shortener + landing page at https://1kb.uz.
//
// One JWC program serves three things:
//   1. The landing page at `/`        — see `landing_html()` in views.jwc
//   2. The shortener API + redirects  — POST /api/links, GET /:code, ...
//   3. Traffic stats + Swagger UI     — /api/v1/stats, /docs, /openapi.json
//
// File layout:
//   main.jwc   — entities, middleware, routes, main() (this file)
//   views.jwc  — HTML / OpenAPI bodies (kept here so this file stays readable)
//
// Caveats:
//   - Redirect bumps hits + resolves the url in one round-trip via a
//     data-modifying CTE (`WITH … UPDATE … RETURNING … SELECT`). See the
//     route for why the query-layer `update … set` form can't be used here.

import redis;

errorHandler (e) {
    return internalError(e.message);
}

dbcontext AppDb : Postgres;

entity Link of AppDb {
    code       varchar(8) pk;    // 7-char slug used in the short URL
    url        varchar(2048);    // original URL
    hits       int;              // click counter
    created_at datetime;
}

entity ApiCall of AppDb {
    id         bigint pk autoincrement;
    path       varchar(200);
    method     varchar(8);
    status     int;
    latency_ms int;
    ts         datetime;
}

// -------------------- helpers --------------------

// Client IP source order: Cloudflare-injected header first (CF strips any
// spoofed value before injecting its own), then `X-Forwarded-For` as a whole
// string (rate-limit only needs a stable bucket key — the comma-separated
// chain still hashes to the same row for the same client), then "unknown".
function client_ip() {
    let ip = header("cf-connecting-ip");
    if (ip == null) {
        ip = header("x-forwarded-for");
    }
    if (ip == null or ip == "") {
        ip = "unknown";
    }
    return ip;
}

// -------------------- middleware --------------------

// 60 requests per rolling 60s window, keyed by client IP.
//
// `redis.rate_limit` runs INCR + EXPIRE as one atomic Lua script, which the
// hand-rolled read-modify-write below it used to get wrong in two ways: two
// concurrent requests could both read the same count and both write count+1,
// and the window was per-process, so N replicas meant an effective limit of
// 60 x N.
//
// With no `JWC_REDIS_URL` the package falls back to the in-process cache —
// same behaviour this middleware had before, so a single-replica or local
// run needs no Redis. `redis.available()` is what distinguishes the two at
// runtime; it is not branched on here because a shortener over its rate
// limit is a nuisance, not a correctness problem, and failing closed when
// Redis is down would be the worse outcome.
middleware RateLimit {
    if (!redis.rate_limit("rl:" + client_ip(), 60, 60)) {
        return { status: 429, error: "rate limited" };
    }
}

// Everything runs in the `after` block, for two reasons.
//
// Correctness: a request-phase middleware cannot see the response, which is
// why `status` used to be hardcoded 200 (even for 404s and 500s) and
// `latency_ms` hardcoded 0 — making every percentile in /stats a zero.
// `response_status()` and `response_duration_ms()` are only meaningful here.
//
// Latency: `log_insert` hands the row to the runtime's buffered writer,
// which batches a few hundred rows into one multi-row INSERT on a background
// task. The previous version called `insert` inline from the *request*
// phase, so every request paid a full database round-trip before its handler
// even started. That is also what the "native AOT can't drive the job queue"
// note used to be about — the buffered writer lives in the runtime and works
// identically under `jwc run` and `jwc build --native`, so the workaround is
// no longer needed.
//
// Rows are dropped rather than queued without bound if the writer falls
// behind; `jwc_log_dropped_total` in /metrics counts them. For traffic
// telemetry that is the right trade — see `log_writer.rs` in jwc-lang.
middleware MetricsTracker {
}
after {
    // `request_path` + `request_method` are JWC 0.3.11+ builtins that
    // expose the live request line. Request context stays live through the
    // after-phase, so both still read the route that just ran.
    let p = request_path();
    if (p == null) { p = "unknown"; }
    let m = request_method();
    if (m == null) { m = "GET"; }

    let row = new ApiCall();
    row.path       = p;
    row.method     = m;
    row.status     = response_status();
    row.latency_ms = response_duration_ms();
    row.ts         = now();
    log_insert("ApiCall", row);
}

// -------------------- routes --------------------

// Liveness — process is up. K8s restarts the pod if this fails.
route GET "healthz" {
    return json({ status: "ok" });
}

// Readiness — pod is allowed to receive traffic. Fails if Postgres is
// unreachable so the load balancer drains us until the DB recovers.
route GET "readyz" {
    try {
        // Cheapest possible round-trip; uses the existing prepared-stmt cache.
        let _ = raw_sql("SELECT 1", "[]");
        return json({ status: "ready" });
    } catch (e) {
        return { status: 503, error: "db_unreachable", message: e.message };
    }
}

// `html(...)` (JWC 0.3.6+) declares `text/html; charset=utf-8` so browsers
// and strict clients both render the page instead of treating it as JSON.
route GET "/" use MetricsTracker {
    return html(landing_html());
}

route GET "docs" {
    return html(landing_docs());
}

route GET "openapi.json" {
    return openapi_spec();
}

// SEO / crawler endpoints. `robots.txt` and `sitemap.xml` are returned as
// bare strings (same pattern as `openapi.json`); `og.svg` backs the
// OpenGraph / Twitter social card referenced from the landing `<head>`.
route GET "robots.txt" {
    return robots_txt();
}

route GET "sitemap.xml" {
    return sitemap_xml();
}

route GET "og.svg" {
    return og_svg();
}

route GET "api/v1/stats" {
    let total = select count(*) from AppDb.ApiCall;
    let last_24h_raw = raw_sql(
        "SELECT COUNT(*) FROM \"api_call\" WHERE ts > NOW() - INTERVAL '24 hours'",
        "[]"
    );
    let last_24h = int(last_24h_raw);
    let total_links = select count(*) from AppDb.Link;
    let total_clicks_raw = raw_sql(
        "SELECT COALESCE(SUM(hits), 0) FROM \"link\"",
        "0"
    );
    let total_clicks = int(total_clicks_raw);
    let top_link_hits_raw = raw_sql(
        "SELECT COALESCE(MAX(hits), 0) FROM \"link\"",
        "0"
    );
    let top_link_hits = int(top_link_hits_raw);
    let top_raw = raw_sql(
        "SELECT COALESCE(json_agg(t), '[]'::json)::text FROM (SELECT code, hits FROM \"link\" WHERE hits > 0 ORDER BY hits DESC LIMIT 5) t",
        "[]"
    );
    return json({
        total:         total,
        last_24h:      last_24h,
        total_links:   total_links,
        total_clicks:  total_clicks,
        top_link_hits: top_link_hits,
        top_endpoints: top_raw,
        written_in:    "JWC",
        source:        "https://github.com/Nodirbek-Abdulaxadov/jwc-shortener"
    });
}

route POST "api/links" use RateLimit, MetricsTracker {
    validate body {
        // Restrict to real web URLs — without this `data:` / `file:` /
        // `javascript:` / arbitrary schemes get short-circuited too and the
        // service becomes an open phishing / abuse relay.
        url: required, minLength(8), maxLength(2048), pattern(r"^https?://");
    }
    let req = body();

    // 7 hex chars = 268M slug space → birthday-collision is ~50% at ~16k links.
    // Cheaper than 8 chars is "retry on PK conflict": try a fresh code up to
    // 5 times, then bail loudly so abuse / pool exhaustion is visible.
    let short_code = "";
    let attempts = 0;
    let inserted = false;
    while (attempts < 5 and inserted == false) {
        attempts = attempts + 1;

        // 7-char slug from a uuid (strip dashes + take first 7). `split(s, "")`
        // returns leading + trailing empty entries — skip them.
        let raw = lower(replace(uuid(), "-", ""));
        short_code = "";
        for ch in split(raw, "") {
            if (length(short_code) >= 7) { break; }
            if (ch != "") {
                short_code = short_code + ch;
            }
        }

        try {
            let row = new Link();
            row.code = short_code;
            row.url  = req.url;
            row.hits = 0;
            row.created_at = now();
            insert row into AppDb.Link;
            inserted = true;
        } catch (e) {
            // Treat any insert error as a probable PK clash and retry.
            // After 5 fresh codes failing back-to-back we re-throw.
            if (attempts >= 5) {
                return internalError("could not allocate short code");
            }
        }
    }

    let short_url_full = env("PUBLIC_BASE_URL") + "/" + short_code;
    let short_url = replace(short_url_full, "https://", "");
    short_url = replace(short_url, "http://", "");

    return created({
        code:  short_code,
        short: short_url,
        qr_svg: qr_img_tag(short_url_full)
    });
}

route GET "api/links/{code}" {
    let code = path_param("code");
    let link = select Link from AppDb.Link where Link.code == @code first;
    if (link == null) {
        return notFound({ error: "no such link" });
    }
    return ok({
        code:       link.code,
        url:        link.url,
        hits:       link.hits,
        created_at: link.created_at
    });
}

// Catch-all redirect. Dedicated routes (healthz, docs, ...) win on the
// router, but defensive guard for case mismatches / trailing dots.
route GET "{code}" use RateLimit, MetricsTracker {
    let code = path_param("code");

    if (code == "healthz" or code == "readyz" or code == "api"
        or code == "docs" or code == "openapi.json" or code == "stats"
        or code == "favicon.ico" or code == "robots.txt"
        or code == "sitemap.xml" or code == "og.svg") {
        return notFound({ error: "not found" });
    }

    // Single round-trip, atomic: a data-modifying CTE bumps hits and the
    // outer SELECT returns the resolved url. Two earlier approaches both
    // broke on the native build:
    //   - `raw_sql(UPDATE … RETURNING url)` alone routes to exec (no
    //     SELECT/WITH prefix) and returns the affected-row count, so the
    //     redirect Location became "1".
    //   - The query-layer `update … set hits = hits + 1` binds the increment
    //     literal as i64, which Postgres rejects against the int4 `hits`
    //     column ("error serializing parameter 0").
    // The CTE wins on both: `hits + 1` stays inline SQL (no bound int), only
    // `code` is a parameter, and the leading WITH makes raw_sql return the
    // url column.
    let params = "[\"" + code + "\"]";
    let url = raw_sql(
        "WITH bumped AS (UPDATE \"link\" SET hits = hits + 1 WHERE code = $1 RETURNING url) SELECT url FROM bumped",
        params
    );

    if (url == null or url == "") {
        return notFound({ error: "no such link" });
    }

    return statusCode(302, { Location: url });
}

function main() {
    // Reads PG_* / DATABASE_URL from env — k8s injects them via the
    // jwc-shortener-secret. Without this every DB-touching route 500s.
    setConnectionString();

    // No job-handler registration: MetricsTracker's `log_insert` goes to the
    // runtime's buffered writer, which owns its own background task and
    // needs no wiring here. JWC_LOG_BATCH / JWC_LOG_FLUSH_MS tune it.

    serve(8080);
}
