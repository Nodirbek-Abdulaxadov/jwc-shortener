// jwc-shortener — URL shortener + landing page at https://1kb.uz.
//
// One JWC program serves three things:
//   1. The landing page at `/`        — see `landing_html()` in views.jwc
//   2. The shortener API + redirects  — POST /api/links, GET /:code, ...
//   3. Traffic stats + Swagger UI     — /api/v1/stats, /docs, /openapi.json
//
// File layout:
//   main.jwc   — entities, middleware, routes, main() (this file)
//   views.jwc  — HTML / OpenAPI bodies (kept here so this file stays readable)
//
// Caveats:
//   - `latency_ms` is always 0 — middleware can't observe response duration
//     yet. p50/p95/p99 in /stats are therefore returned as 0.
//   - Rate limit is per-process (in-process cache, 60s window). Single replica
//     only — behind multiple pods use a shared Redis cache.

errorHandler (e) {
    return internalError(e.message);
}

dbcontext AppDb : Postgres;

entity Link of AppDb {
    code       varchar(8) pk;    // 7-char slug used in the short URL
    url        varchar(2048);    // original URL
    hits       int;              // click counter
    created_at datetime;
}

entity ApiCall of AppDb {
    id         bigint pk autoincrement;
    path       varchar(200);
    method     varchar(8);
    status     int;
    latency_ms int;
    ts         datetime;
}

// -------------------- middleware --------------------

middleware RateLimit {
    let ip = header("x-forwarded-for");
    if (ip == null) {
        ip = "unknown";
    }
    let key = "rl:" + ip;
    let count = cache_get(key);
    if (count == null) {
        cache_set(key, "1", 60);
    } else {
        let n = int(count) + 1;
        if (n >= 60) {
            return { status: 429, error: "rate limited" };
        }
        cache_set(key, "" + n, 60);
    }
}

middleware MetricsTracker {
    // `request_path` + `request_method` are JWC 0.3.11+ builtins that
    // expose the live request line. Before that we had to read fake
    // `x-jwc-path` headers — they never existed, so every row landed
    // as path="unknown".
    let p = request_path();
    if (p == null) { p = "unknown"; }
    let m = request_method();
    if (m == null) { m = "GET"; }
    try {
        let row = new ApiCall();
        row.path = p;
        row.method = m;
        row.status = 200;
        row.latency_ms = 0;
        row.ts = now();
        insert row into AppDb.ApiCall;
    } catch (e) {
        // Swallow — metrics must never break the request.
    }
}

// -------------------- routes --------------------

route GET "healthz" {
    return json({ status: "ok" });
}

// `html(...)` (JWC 0.3.6+) declares `text/html; charset=utf-8` so browsers
// and strict clients both render the page instead of treating it as JSON.
route GET "/" use MetricsTracker {
    return html(landing_html());
}

route GET "docs" {
    return html(landing_docs());
}

route GET "openapi.json" {
    return openapi_spec();
}

route GET "api/v1/stats" {
    let total = select count(*) from AppDb.ApiCall;
    let last_24h_raw = raw_sql(
        "SELECT COUNT(*) FROM \"api_call\" WHERE ts > NOW() - INTERVAL '24 hours'",
        "[]"
    );
    let last_24h = int(last_24h_raw);
    let total_links = select count(*) from AppDb.Link;
    let total_clicks_raw = raw_sql(
        "SELECT COALESCE(SUM(hits), 0) FROM \"link\"",
        "0"
    );
    let total_clicks = int(total_clicks_raw);
    let top_link_hits_raw = raw_sql(
        "SELECT COALESCE(MAX(hits), 0) FROM \"link\"",
        "0"
    );
    let top_link_hits = int(top_link_hits_raw);
    let top_raw = raw_sql(
        "SELECT COALESCE(json_agg(t), '[]'::json)::text FROM (SELECT code, hits FROM \"link\" WHERE hits > 0 ORDER BY hits DESC LIMIT 5) t",
        "[]"
    );
    return json({
        total:         total,
        last_24h:      last_24h,
        total_links:   total_links,
        total_clicks:  total_clicks,
        top_link_hits: top_link_hits,
        top_endpoints: top_raw,
        written_in:    "JWC",
        source:        "https://github.com/Nodirbek-Abdulaxadov/jwc-shortener"
    });
}

route POST "api/links" use MetricsTracker {
    validate body {
        url: required, minLength(8), maxLength(2048);
    }
    let req = body();

    // 7-char slug from a uuid (strip dashes + take first 7). The unique
    // PK enforces correctness if a (vanishingly unlikely) collision hits.
    // `split(s, "")` returns leading + trailing empty entries we skip.
    let raw = lower(replace(uuid(), "-", ""));
    let short_code = "";
    for ch in split(raw, "") {
        if (length(short_code) >= 7) { break; }
        if (ch != "") {
            short_code = short_code + ch;
        }
    }

    let row = new Link();
    row.code = short_code;
    row.url  = req.url;
    row.hits = 0;
    row.created_at = now();
    insert row into AppDb.Link;

    let short_url = env("PUBLIC_BASE_URL") + "/" + short_code;
    short_url = replace(short_url, "https://", "");
    short_url = replace(short_url, "http://", "");

    return created({
        code:  short_code,
        short: short_url
    });
}

route GET "api/links/{code}" {
    let code = path_param("code");
    let link = select Link from AppDb.Link where Link.code == @code first;
    if (link == null) {
        return notFound({ error: "no such link" });
    }
    return ok({
        code:       link.code,
        url:        link.url,
        hits:       link.hits,
        created_at: link.created_at
    });
}

// Catch-all redirect. Dedicated routes (healthz, docs, ...) win on the
// router, but defensive guard for case mismatches / trailing dots.
route GET "{code}" use MetricsTracker {
    let code = path_param("code");

    if (code == "healthz" or code == "api" or code == "docs"
        or code == "openapi.json" or code == "stats" or code == "favicon.ico") {
        return notFound({ error: "not found" });
    }

    let link = select Link from AppDb.Link where Link.code == @code first;
    if (link == null) {
        return notFound({ error: "no such link" });
    }

    link.hits = link.hits + 1;
    update link in AppDb.Link;

    return statusCode(302, { Location: link.url });
}

function main() {
    // Reads PG_* / DATABASE_URL from env — k8s injects them via the
    // jwc-shortener-secret. Without this every DB-touching route 500s.
    setConnectionString();
    serve(8080);
}
