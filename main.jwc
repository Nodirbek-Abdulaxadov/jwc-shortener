// jwc-shortener v2 — URL shortener, system-design rewrite.
//
// Read path (~99% of traffic):
//   GET /{code} → ONE Redis round-trip (Lua: cache GET + HINCRBY hit bucket
//   + flush-cursor claim) → 302. A cache miss loads from Postgres and caches
//   the entry for up to 300s. Unknown codes are negative-cached ("__404__",
//   60s): a public shortener eats permanent code-enumeration scans, and
//   without the negative entry every probe would hit Postgres.
//
// Hit counting:
//   Every redirect does HINCRBY hits:{floor(now/10)} <code> 1. The bucket
//   that just closed is drained back to Postgres by whichever redirect first
//   observes the rollover — there is no background scheduler in a native JWC
//   binary (the queue API is interp-only), so the flusher piggybacks on
//   traffic: the Lua script atomically claims the closed range via
//   "hits:cursor", and only the claiming request pays the drain. Buckets
//   carry a 1h TTL, so an idle gap loses nothing.
//
// Redirects are deliberately NOT logged per-request — at 100:1 read:write a
// per-hit log row would bottleneck the single server. The counter IS the
// analytics source (link.hits + link_stat_daily).
//
// Status codes: missing and blocked both answer an identical 404 (no oracle);
// owner-deleted and expired answer 410.
//
// Degradation:
//   - No JWC_REDIS_URL (local dev): the redis package falls back to the
//     in-process cache; hits are bumped directly in Postgres per redirect.
//   - Redis configured but down: RedisError → same per-request PG fallback.
//   - Postgres down: cached redirects keep working; the rest 5xx.

import redis;

errorHandler (e) {
    return internalError(e.message);
}

dbcontext AppDb : Postgres;

entity Link of AppDb {
    code       varchar(8) pk;        // base62(permute(nextval)), always 6 chars
    url        varchar(2048);        // immutable after create
    dest_host  varchar(255) index;   // extracted host — abuse/takedown queries
    owner_sub  varchar(255);         // IdP subject; composite index in migration
    status     varchar(16);          // active | blocked
    hits       bigint;               // flushed from Redis buckets
    created_at datetime;
    expires_at datetime nullable;
    deleted_at datetime nullable;    // soft delete
}

entity AppUser of AppDb {
    sub        varchar(255) pk;
    email      varchar(320) nullable;
    status     varchar(16);
    created_at datetime;
}

entity BlockedHost of AppDb {
    host varchar(255) pk;
}

// link_stat_daily has a composite PK (code, day) which entities can't declare
// yet — it lives in the migration and is only touched via raw_sql.

// -------------------- constants --------------------

const CACHE_TTL_SECS = 300;
const NEG_TTL_SECS   = 60;

// musanna-platform's platform-wide administrator role.
const ADMIN_ROLE = "SuperAdmin";

// One round-trip for the hot path. KEYS = [link:{code}, hits:{bucket},
// hits:cursor], ARGV = [code, bucket]. Returns a JSON object so three answers
// cross in one reply: v ("" = miss, "__404__"/"__410__" = negative entry,
// else the cached JSON), and [from..to] — the closed-bucket range THIS request
// atomically claimed for flushing (from = -1 for everyone else). A missing
// cursor is initialised without claiming: nothing was counted before it.
const HIT_SCRIPT =
    "local v = redis.call('GET', KEYS[1]) " +
    "if v and v ~= '__404__' and v ~= '__410__' then " +
    "redis.call('HINCRBY', KEYS[2], ARGV[1], 1) " +
    "redis.call('EXPIRE', KEYS[2], 3600) end " +
    "local target = tonumber(ARGV[2]) - 1 " +
    "local from = -1 " +
    "local c = tonumber(redis.call('GET', KEYS[3])) " +
    "if not c then redis.call('SET', KEYS[3], target) " +
    "elseif c < target then redis.call('SET', KEYS[3], target) from = c + 1 end " +
    "if v == false then v = '' end " +
    "return cjson.encode({v = v, from = from, to = target})";

// Count a hit for the cache-miss path (the entry was just loaded from PG).
const COUNT_SCRIPT =
    "redis.call('HINCRBY', KEYS[1], ARGV[1], 1) " +
    "redis.call('EXPIRE', KEYS[1], 3600) return ''";

// Read one closed bucket. HGETALL has no JWC built-in, so it goes through
// Lua; `cjson.encode` is what carries the flat field/value list back as one
// string. The DELETE is deliberately NOT here — see `flush_bucket`.
const READ_SCRIPT = "return cjson.encode(redis.call('HGETALL', KEYS[1]))";

// -------------------- helpers --------------------

// `env()` answers with an EMPTY STRING for a variable that is not set, not
// with null, so `??` never fires and the caller silently gets "". That is
// how the landing page ended up rendering `href=''` for its panel link.
function env_or(name: string, fallback: string): string {
    let v = env(name);
    if (v == null or v == "") { return fallback; }
    return v;
}

function base_url(): string {
    return env_or("PUBLIC_BASE_URL", "http://localhost:8080");
}

// Where the Angular panel is served from. Separate origin in development
// (`npm start` on 4400); behind one hostname in production.
function admin_url(): string {
    return env_or("ADMIN_URL", "http://localhost:4400");
}

function int_env(name: string, fallback: int): int {
    let v = env(name);
    if (v == null or v == "") { return fallback; }
    return int(v);
}

function link_cache_key(code: string): string {
    return "link:" + code;
}

// QR image URL for a short link. Inlined rather than taken from the
// `qr-lite` package: that package declares no `namespace`, so its decls
// default to the namespace "qr-lite" — which has a dash and therefore
// cannot be written as a qualified call, leaving its functions
// unreachable from an app (`Unknown function: qr_img_tag` at runtime).
//
// Only the short URL is encoded here, and a short URL is
// scheme + host + "/" + base62, so ":" and "/" are the only characters
// that ever need escaping.
function qr_url(text: string): string {
    let encoded = "";
    for ch in split(text, "") {
        if (ch == "") { continue; }
        if (ch == ":") {
            encoded = encoded + "%3A";
        } else if (ch == "/") {
            encoded = encoded + "%2F";
        } else {
            encoded = encoded + ch;
        }
    }
    return "https://barcodeapi.org/api/qr/" + encoded + "?format=svg";
}

// Best-effort cache ops: when Redis is configured but unreachable these
// raise RedisError, and a cache problem must never fail a request that
// Postgres can still answer. Unconfigured Redis needs no guard — the
// package already falls back to the in-process cache.
function cache_read(key: string) {
    try {
        return redis.get(key);
    } catch (e: RedisError) {
        return null;
    }
}

function cache_put(key: string, value: string, ttl_secs: int) {
    try {
        redis.set(key, value, ttl_secs);
    } catch (e: RedisError) {
        // best-effort
    }
}

// Rate limit / quota that fails OPEN when Redis is configured but dead:
// blocking all creates because the limiter store is down is the worse
// outcome. Unconfigured Redis falls back to the in-process limiter.
function allow(key: string, limit: int, window_secs: int): bool {
    try {
        return redis.rate_limit(key, limit, window_secs);
    } catch (e: RedisError) {
        return true;
    }
}

// Cache TTL for a live entry: min(300s, expires_at - now).
function entry_ttl(exp_unix: int): int {
    if (exp_unix <= 0) { return CACHE_TTL_SECS; }
    let left = exp_unix - unix_timestamp();
    if (left < 1) { return 1; }
    if (left > CACHE_TTL_SECS) { return CACHE_TTL_SECS; }
    return left;
}

// Host portion of an http(s) URL, lowercased, port stripped, userinfo
// handled ("https://user@evil.com/x" → "evil.com"). Returns "" when the
// URL has no recognisable authority.
function extract_host(url: string): string {
    let rest = "";
    if (starts_with(url, "https://")) {
        rest = substring(url, 8, length(url) - 8);
    } else if (starts_with(url, "http://")) {
        rest = substring(url, 7, length(url) - 7);
    } else {
        return "";
    }
    let authority = "";
    for ch in split(rest, "") {
        if (ch == "") { continue; }
        if (ch == "/" or ch == "?" or ch == "#") { break; }
        authority = authority + ch;
    }
    // userinfo: the real host follows the LAST "@"
    let host = authority;
    if (contains(authority, "@")) {
        host = "";
        for part in split(authority, "@") {
            if (part != "") { host = part; }
        }
    }
    let hostname = "";
    for c in split(host, "") {
        if (c == "") { continue; }
        if (c == ":") { break; }
        hostname = hostname + c;
    }
    return lower(hostname);
}

// Literal private/loopback targets and self-redirect loops. This checks the
// URL as written — it does not resolve DNS, so a hostname that resolves to a
// private address (DNS rebinding) is out of scope for a shortener: the
// redirect is followed by the visitor's browser, not by this server.
function is_forbidden_host(h: string): bool {
    if (h == "" or h == "localhost") { return true; }
    if (starts_with(h, "[")) { return true; }   // IPv6 literal — reject wholesale
    if (starts_with(h, "127.") or starts_with(h, "10.")
        or starts_with(h, "192.168.") or starts_with(h, "169.254.")
        or starts_with(h, "0.")) { return true; }
    if (starts_with(h, "172.")) {
        // 172.16.0.0/12 — second octet 16..31
        let idx = 0;
        for p in split(h, ".") {
            if (p == "") { continue; }
            idx = idx + 1;
            if (idx == 2) {
                let octet = -1;
                try { octet = int(p); } catch (e) { octet = -1; }
                if (octet >= 16 and octet <= 31) { return true; }
                break;
            }
        }
    }
    if (h == extract_host(base_url())) { return true; }   // redirect loop
    return false;
}

// -------------------- read path --------------------

// Load a link from Postgres, folded to what the redirect needs:
// null/"" = no such code; else JSON {st: ok|blocked|gone, u: url, e: expiry
// unix}. No return annotation: raw_sql hands an empty result back as null.
function load_link(code: string) {
    return raw_sql(
        "SELECT COALESCE((SELECT json_build_object("
        + "'st', CASE WHEN deleted_at IS NOT NULL THEN 'gone' "
        +            "WHEN status <> 'active' THEN 'blocked' "
        +            "WHEN expires_at IS NOT NULL AND expires_at <= now() THEN 'gone' "
        +            "ELSE 'ok' END, "
        + "'u', url, "
        + "'e', COALESCE(EXTRACT(EPOCH FROM expires_at)::bigint, 0))::text "
        + "FROM \"link\" WHERE code = $1), '')",
        json_stringify([code]));
}

// Direct Postgres hit bump for degraded mode (no usable Redis): one CTE
// keeps link.hits and the daily stat in a single round-trip.
function count_hit_pg(code: string) {
    raw_sql(
        "WITH b AS (UPDATE \"link\" SET hits = hits + 1 WHERE code = $1 RETURNING code) "
        + "INSERT INTO \"link_stat_daily\" (code, day, hits) SELECT code, CURRENT_DATE, 1 FROM b "
        + "ON CONFLICT (code, day) DO UPDATE SET hits = link_stat_daily.hits + 1",
        json_stringify([code]));
}

// Cache-miss tail shared by both modes. bucket >= 0 → count via the Redis
// bucket; bucket < 0 → count straight into Postgres.
function serve_from_db(code: string, bucket: int) {
    let found = load_link(code);
    if (found == null or found == "") {
        cache_put(link_cache_key(code), "__404__", NEG_TTL_SECS);
        return notFound({ error: "not found" });
    }
    let row = json_parse(found);
    if (row.st == "blocked") {
        // Identical body and cache TTL as "missing" — no blocked-oracle.
        cache_put(link_cache_key(code), "__404__", NEG_TTL_SECS);
        return notFound({ error: "not found" });
    }
    if (row.st == "gone") {
        cache_put(link_cache_key(code), "__410__", NEG_TTL_SECS);
        return statusCode(410, { error: "gone" });
    }
    cache_put(link_cache_key(code), json_stringify({ u: row.u, e: row.e }), entry_ttl(row.e));
    if (bucket >= 0) {
        try {
            redis_eval(COUNT_SCRIPT, json_stringify(["hits:" + bucket]), json_stringify([code]));
        } catch (e: RedisError) {
            count_hit_pg(code);
        }
    } else {
        count_hit_pg(code);
    }
    return statusCode(302, { Location: row.u });
}

// Drain claimed buckets into Postgres. Only ever runs on the one request
// that won the cursor claim, so ~one request per 10s pays a few extra
// round-trips.
//
// A failure here is LOGGED, not swallowed: the bucket is only deleted after
// Postgres has taken the delta, so a failed flush leaves the counts in
// Redis — but it also means the cursor has moved past that bucket and
// nothing will retry it. Silence would turn "counters stopped moving" into
// a mystery.
function flush_range(from: int, to: int) {
    let b = from;
    if (to - b > 30) { b = to - 30; }   // older buckets are past TTL anyway
    while (b <= to) {
        try {
            flush_bucket(b);
        } catch (e) {
            print("hit flush failed for bucket " + b + ": " + e.message);
        }
        b = b + 1;
    }
}

function flush_bucket(bucket: int) {
    let raw = redis_eval(READ_SCRIPT, json_stringify(["hits:" + bucket]), json_stringify([]));
    if (raw == null or raw == "" or raw == "{}" or raw == "[]") { return; }
    // HGETALL comes back as a flat [field, value, field, value, ...] array;
    // fold it into two Postgres array literals (codes are base62 — no quoting).
    let flat = json_parse(raw);
    let codes = "";
    let deltas = "";
    let field = "";
    let is_field = true;
    for item in flat {
        if (is_field) {
            field = item;
            is_field = false;
        } else {
            if (codes != "") {
                codes = codes + ",";
                deltas = deltas + ",";
            }
            codes = codes + field;
            deltas = deltas + item;
            is_field = true;
        }
    }
    if (codes == "") { return; }
    // Comma-joined lists split by Postgres, NOT array literals bound to
    // `$1::text[]`: that form makes Postgres infer the PARAMETER as an
    // array type, and the driver sends a string — the bind then fails with
    // a bare "Failed to execute SQL statement". `string_to_array($1, ',')`
    // keeps both parameters plain text, which is what JWC can bind.
    let params = json_stringify([codes, deltas]);
    raw_sql(
        "UPDATE \"link\" SET hits = link.hits + v.d "
        + "FROM (SELECT unnest(string_to_array($1, ',')) AS code, "
        + "unnest(string_to_array($2, ',')::bigint[]) AS d) v "
        + "WHERE link.code = v.code",
        params);
    raw_sql(
        "INSERT INTO \"link_stat_daily\" (code, day, hits) "
        + "SELECT v.code, CURRENT_DATE, v.d "
        + "FROM (SELECT unnest(string_to_array($1, ',')) AS code, "
        + "unnest(string_to_array($2, ',')::bigint[]) AS d) v "
        + "ON CONFLICT (code, day) DO UPDATE SET hits = link_stat_daily.hits + EXCLUDED.hits",
        params);
    // Only now is the bucket safe to drop. Draining and deleting in one
    // script (the obvious shape) loses the whole bucket whenever the
    // Postgres write afterwards fails — the deltas are already gone.
    redis.del("hits:" + bucket);
}

function redirect_via_redis(code: string) {
    let bucket = int(unix_timestamp() / 10);
    let reply = redis_eval(HIT_SCRIPT,
        json_stringify([link_cache_key(code), "hits:" + bucket, "hits:cursor"]),
        json_stringify([code, bucket]));
    let r = json_parse(reply);
    if (r.from >= 0) { flush_range(r.from, r.to); }
    if (r.v == "") { return serve_from_db(code, bucket); }
    if (r.v == "__404__") { return notFound({ error: "not found" }); }
    if (r.v == "__410__") { return statusCode(410, { error: "gone" }); }
    let entry = json_parse(r.v);
    if (entry.e > 0 and entry.e <= unix_timestamp()) {
        // Expired while cached. The Lua HINCRBY above already counted this
        // request — one stray hit at the expiry boundary is accepted.
        cache_put(link_cache_key(code), "__410__", NEG_TTL_SECS);
        return statusCode(410, { error: "gone" });
    }
    return statusCode(302, { Location: entry.u });
}

function redirect_via_pg(code: string) {
    let cached = cache_read(link_cache_key(code));
    if (cached == "__404__") { return notFound({ error: "not found" }); }
    if (cached == "__410__") { return statusCode(410, { error: "gone" }); }
    if (cached != null) {
        let entry = json_parse(cached);
        if (entry.e > 0 and entry.e <= unix_timestamp()) {
            cache_put(link_cache_key(code), "__410__", NEG_TTL_SECS);
            return statusCode(410, { error: "gone" });
        }
        count_hit_pg(code);
        return statusCode(302, { Location: entry.u });
    }
    return serve_from_db(code, -1);
}

// Record the caller on first sight. JWC has no upsert syntax, so this is a
// read-then-write; the unique violation from two concurrent first requests
// is caught rather than prevented, which is the same outcome ON CONFLICT
// DO NOTHING would give.
function ensure_user(sub: string, email: string) {
    let existing = select AppUser from AppDb.AppUser where AppUser.sub == @sub first;
    if (existing != null) { return; }
    let u = new AppUser();
    u.sub        = sub;
    u.status     = "active";
    u.created_at = now();
    if (email != "") {
        u.email = email;
    }
    try {
        insert u into AppDb.AppUser;
    } catch (e: DbError.UniqueViolation) {
        // Raced with another request from the same new user — already there.
    }
}

// -------------------- middleware --------------------

// OIDC bearer auth against the IdP's JWKS (RS256). iss/aud/leeway are
// enforced by the runtime via JWC_JWT_EXPECTED_ISS / _AUD / _LEEWAY_SECS.
//
// There is no symmetric-secret escape hatch: with JWKS_URL unset every
// authed route answers 503 rather than letting requests through.
middleware Auth {
    let raw = header("authorization");
    if (raw == null or raw == "") {
        return unauthorized({ error: "missing bearer token" });
    }
    let jwks = env("JWKS_URL");
    if (jwks == null or jwks == "") {
        return statusCode(503, { error: "auth not configured" });
    }
    let claims = null;
    try {
        claims = json_parse(await jwt_verify_jwks(raw, jwks));
    } catch (e) {
        return unauthorized({ error: "invalid token" });
    }
    if (claims == null or claims.sub == null) {
        return unauthorized({ error: "invalid token" });
    }
    setContext("sub", claims.sub);
    setContext("email", claims.email ?? "");
    setContext("name", claims.name ?? "");
    setContext("roles", json_stringify(claims.role ?? []));
}

// Platform administrators only. Runs after `Auth`, which is what puts the
// roles in context — `use Auth, AdminOnly` in that order.
middleware AdminOnly {
    // The role claim is string-or-array depending on how many roles the user
    // has, so both shapes are matched against the JSON form rather than
    // branching on the type.
    if (!contains(context("roles") ?? "", "\"" + ADMIN_ROLE + "\"")) {
        return forbidden({ error: "admin only" });
    }
}

// -------------------- routes --------------------

route GET "/" {
    return html(landing_html());
}

// Public counters for the landing page. Hits are flushed from Redis every
// ~10s, so these lag by at most one bucket.
route GET "api/stats" {
    let links = select count(*) from AppDb.Link where Link.deleted_at is null;
    let clicks = raw_sql(
        "SELECT COALESCE(SUM(hits), 0)::text FROM \"link\" WHERE deleted_at IS NULL", "[]");
    let today = raw_sql(
        "SELECT COALESCE(SUM(hits), 0)::text FROM \"link_stat_daily\" WHERE day = CURRENT_DATE", "[]");
    return json({ links: links, clicks: int(clicks), today: int(today) });
}

route POST "api/links" use Auth {
    validate body {
        url:        required, minLength(10), maxLength(2048), pattern(r"^https?://");
        expires_at: maxLength(64);
    }
    let req = body();
    let sub = context("sub");

    // Quota before validation (per design): a rejected create still burns it.
    if (!allow("rl:user:" + sub, int_env("CREATE_RATE_LIMIT", 10), 60)) {
        return statusCode(429, { error: "rate limited" });
    }
    let day = int(unix_timestamp() / 86400);
    if (!allow("quota:d:" + sub + ":" + day, int_env("DAILY_QUOTA", 100), 172800)) {
        return statusCode(429, { error: "daily quota exceeded" });
    }
    let month = int(unix_timestamp() / 2592000);
    if (!allow("quota:m:" + sub + ":" + month, int_env("MONTHLY_QUOTA", 1000), 3110400)) {
        return statusCode(429, { error: "monthly quota exceeded" });
    }

    let host = extract_host(req.url);
    if (is_forbidden_host(host)) {
        return badRequest("url host not allowed");
    }
    let blocked = select BlockedHost from AppDb.BlockedHost
        where BlockedHost.host == @host first;
    if (blocked != null) {
        return badRequest("url host not allowed");
    }

    // expires_at (optional): let Postgres judge the format, reject the past.
    // The comparison returns a CASE token rather than a cast boolean —
    // `boolean::text` is 'true'/'false', not the 't'/'f' that Postgres
    // *displays*, and the mismatch silently rejected every valid date.
    let exp = "" + (req.expires_at ?? "");
    if (exp != "") {
        let in_future = "n";
        try {
            in_future = raw_sql(
                "SELECT CASE WHEN $1::timestamptz > now() THEN 'y' ELSE 'n' END",
                json_stringify([exp]));
        } catch (e) {
            return badRequest("expires_at: invalid timestamp");
        }
        if (in_future != "y") {
            return badRequest("expires_at must be in the future");
        }
    }

    // Both writes go through the entity layer rather than raw_sql, and that
    // is load-bearing: raw_sql binds parameters by the STRING's shape, so a
    // GUID-shaped `sub` from the IdP is sent as a Postgres `uuid` and the
    // varchar column rejects it. The entity binder uses the declared column
    // type instead. `sub` cannot be a uuid column either — a
    // client_credentials token carries the client id there, not a GUID.
    ensure_user(sub, context("email") ?? "");

    // Code generation stays in SQL (bijective permutation of a sequence, no
    // collision retry) but is now its own round-trip, since the INSERT that
    // consumes it is an entity insert.
    let code = raw_sql("SELECT next_code()", "[]");

    let row = new Link();
    row.code       = code;
    row.url        = req.url;
    row.dest_host  = host;
    row.owner_sub  = sub;
    row.status     = "active";
    row.hits       = 0;
    row.created_at = now();
    if (exp != "") {
        row.expires_at = exp;
    }
    insert row into AppDb.Link;

    let short_full = base_url() + "/" + code;
    let short = replace(replace(short_full, "https://", ""), "http://", "");
    return created({ code: code, short: short, qr: qr_url(short_full) });
}

route GET "api/links/{code}" {
    let code = path_param("code");
    let link = select Link from AppDb.Link
        where Link.code == @code and Link.deleted_at is null first;
    if (link == null or link.status != "active") {
        return notFound({ error: "not found" });
    }
    return ok({
        code:       link.code,
        url:        link.url,
        hits:       link.hits,
        created_at: link.created_at
    });
}

route GET "api/me/links" use Auth {
    let sub = context("sub");
    let links = select Link { code, url, hits, status, created_at, expires_at }
        from AppDb.Link
        where Link.owner_sub == @sub and Link.deleted_at is null
        orderby Link.created_at desc
        limit 200;
    return ok(links);
}

route DELETE "api/me/links/{code}" use Auth {
    let sub = context("sub");
    let code = path_param("code");
    let link = select Link from AppDb.Link
        where Link.code == @code and Link.owner_sub == @sub and Link.deleted_at is null first;
    if (link == null) {
        return notFound({ error: "not found" });
    }
    link.deleted_at = now();
    update link in AppDb.Link;
    // Invalidate immediately — write the tombstone instead of DEL so the
    // next hit answers 410 from cache without touching Postgres.
    cache_put(link_cache_key(code), "__410__", NEG_TTL_SECS);
    return ok({ deleted: code });
}

// -------------------- admin --------------------

route GET "api/admin/stats" use Auth, AdminOnly {
    let links = select count(*) from AppDb.Link where Link.deleted_at is null;
    let users = select count(*) from AppDb.AppUser;
    let blocked = select count(*) from AppDb.Link where Link.status != "active";
    let clicks = raw_sql(
        "SELECT COALESCE(SUM(hits), 0)::text FROM \"link\" WHERE deleted_at IS NULL", "[]");
    // Last 14 days as a dense series — days with no traffic must still appear
    // or the chart silently compresses the gaps and misreads the trend.
    let series = raw_sql(
        "SELECT COALESCE(json_agg(row_to_json(t) ORDER BY t.day), '[]')::text FROM ("
        + "SELECT d::date AS day, COALESCE(SUM(s.hits), 0)::bigint AS hits "
        + "FROM generate_series(CURRENT_DATE - 13, CURRENT_DATE, interval '1 day') d "
        + "LEFT JOIN \"link_stat_daily\" s ON s.day = d::date "
        + "GROUP BY d) t", "[]");
    let top = raw_sql(
        "SELECT COALESCE(json_agg(row_to_json(t)), '[]')::text FROM ("
        + "SELECT code, url, hits FROM \"link\" WHERE deleted_at IS NULL AND hits > 0 "
        + "ORDER BY hits DESC LIMIT 10) t", "[]");
    return json({
        links:  links,
        users:  users,
        blocked: blocked,
        clicks: int(clicks),
        series: json_parse(series),
        top:    json_parse(top)
    });
}

route GET "api/admin/links" use Auth, AdminOnly {
    let q = query_param("q", "");
    let rows = raw_sql(
        "SELECT COALESCE(json_agg(row_to_json(t) ORDER BY t.created_at DESC), '[]')::text FROM ("
        + "SELECT l.code, l.url, l.dest_host, l.owner_sub, l.status, l.hits, "
        + "l.created_at, l.expires_at, l.deleted_at, u.email AS owner_email "
        + "FROM \"link\" l LEFT JOIN \"app_user\" u ON u.sub = l.owner_sub "
        + "WHERE ($1 = '' OR l.code ILIKE '%' || $1 || '%' OR l.url ILIKE '%' || $1 || '%') "
        + "ORDER BY l.created_at DESC LIMIT 500) t",
        json_stringify([q]));
    return json({ data: json_parse(rows) });
}

// Block / unblock. A blocked link answers the same 404 as a missing one, so
// the cache entry is replaced rather than dropped: dropping it would let the
// next request refill it from Postgres with the old value only if the write
// had not committed — replacing is unconditional.
route POST "api/admin/links/{code}/status" use Auth, AdminOnly {
    validate body {
        status: required, minLength(6), maxLength(7), pattern(r"^(active|blocked)$");
    }
    let code = path_param("code");
    let req = body();
    let want = req.status;
    let link = select Link from AppDb.Link where Link.code == @code first;
    if (link == null) {
        return notFound({ error: "not found" });
    }
    // `set` takes a literal, not a bound parameter, so the two transitions
    // are spelled out rather than parameterised.
    if (want == "blocked") {
        update AppDb.Link set status = "blocked" where Link.code == @code;
    } else {
        update AppDb.Link set status = "active" where Link.code == @code;
    }
    if (want == "active") {
        try { redis.del(link_cache_key(code)); } catch (e: RedisError) { }
    } else {
        cache_put(link_cache_key(code), "__404__", NEG_TTL_SECS);
    }
    return ok({ code: code, status: want });
}

route GET "api/admin/users" use Auth, AdminOnly {
    let rows = raw_sql(
        "SELECT COALESCE(json_agg(row_to_json(t) ORDER BY t.created_at DESC), '[]')::text FROM ("
        + "SELECT u.sub, u.email, u.status, u.created_at, "
        + "COUNT(l.code) FILTER (WHERE l.deleted_at IS NULL) AS links, "
        + "COALESCE(SUM(l.hits) FILTER (WHERE l.deleted_at IS NULL), 0)::bigint AS clicks "
        + "FROM \"app_user\" u LEFT JOIN \"link\" l ON l.owner_sub = u.sub "
        + "GROUP BY u.sub) t", "[]");
    return json({ data: json_parse(rows) });
}

route GET "api/admin/hosts" use Auth, AdminOnly {
    let hosts = select BlockedHost from AppDb.BlockedHost orderby BlockedHost.host asc;
    return json({ data: hosts });
}

route POST "api/admin/hosts" use Auth, AdminOnly {
    validate body {
        host: required, minLength(3), maxLength(255);
    }
    let hreq = body();
    let h = lower(hreq.host);
    let existing = select BlockedHost from AppDb.BlockedHost where BlockedHost.host == @h first;
    if (existing != null) {
        return ok({ host: h });
    }
    let row = new BlockedHost();
    row.host = h;
    try {
        insert row into AppDb.BlockedHost;
    } catch (e: DbError.UniqueViolation) {
        // Raced with another admin — the end state is what was asked for.
    }
    return created({ host: h });
}

route DELETE "api/admin/hosts/{host}" use Auth, AdminOnly {
    let h = lower(path_param("host"));
    delete from AppDb.BlockedHost where BlockedHost.host == @h;
    return ok({ deleted: h });
}

// Catch-all redirect — declared LAST so it can't shadow the routes above.
// /healthz, /readyz and /metrics are runtime built-ins and never reach it.
route GET "{code}" {
    let code = path_param("code");
    // next_code() always emits exactly 6 base62 chars: anything else is a
    // scan or a typo, answered without touching cache or database.
    if (length(code) != 6) {
        return notFound({ error: "not found" });
    }
    if (redis.available()) {
        try {
            return redirect_via_redis(code);
        } catch (e: RedisError) {
            return redirect_via_pg(code);
        }
    }
    return redirect_via_pg(code);
}

function main() {
    setConnectionString();
    serve(8080);
}
