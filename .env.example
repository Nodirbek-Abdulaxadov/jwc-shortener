# Copy to `.env` (git-ignored) and adjust. `jwc run` loads it before main().

# --- Postgres ---------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=1234
PG_DATABASE=jwc_shortener_db

# --- Redis (optional locally) -----------------------------------------
# Unset: caching falls back in-process and hits are counted straight into
# Postgres. That is the dev path, not the production one.
JWC_REDIS_URL=redis://localhost:6379

# --- This service -----------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8080
DAILY_QUOTA=100
MONTHLY_QUOTA=1000
CREATE_RATE_LIMIT=10

# --- Auth: musanna-platform (OpenIddict) ------------------------------
# Access tokens are unencrypted RS256 JWS, so JWKS alone validates them.
# musanna dev host: dotnet run --project src/Bootstrapper/Api --launch-profile http
# Discovery: http://localhost:5246/.well-known/openid-configuration
JWKS_URL=http://localhost:5246/.well-known/jwks

# `aud` comes from the scope's resource: requesting `shortener.api` puts
# `musanna.shortener` in the token. Without an expected-aud the service
# would accept any musanna token, including ones minted for other apps.
JWC_JWT_EXPECTED_ISS=http://localhost:5246/
JWC_JWT_EXPECTED_AUD=musanna.shortener
JWC_JWT_LEEWAY_SECS=30
