// Landing / Swagger UI / OpenAPI bodies — kept here so `main.jwc` stays
// readable. JWC has no module system, but every `.jwc` file in the project
// merges into one flat namespace, so these functions are callable from
// `main.jwc` exactly like locally-defined ones.
//
// HTML uses single-quoted attributes because a raw string literal in JWC
// (`r"..."`) ends at the first `"`. Keeping attributes single-quoted means
// we don't have to escape anything.

function landing_html(): string {
    return r"<!DOCTYPE html>
<html lang='en'>
<head>
<meta charset='utf-8'>
<meta name='viewport' content='width=device-width, initial-scale=1'>
<title>1kb.uz — shorten a URL, read a language</title>
<style>
:root { --bg:#0b0d10; --panel:#14181d; --panel-2:#1b2027; --text:#e6e8eb; --muted:#8a9099; --accent:#6ee7b7; --border:#232830; }
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; background: var(--bg); color: var(--text); }
body { font: 15px/1.55 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; max-width: 920px; margin: 0 auto; padding: 48px 24px 64px; }
h1 { font-size: 40px; letter-spacing: -0.02em; margin: 0 0 4px; }
h1 .dot { color: var(--accent); }
.lede { color: var(--muted); font-size: 17px; margin: 0 0 32px; }
.links { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 32px; }
.links a { color: var(--text); text-decoration: none; padding: 8px 14px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; transition: background .15s, border-color .15s; }
.links a:hover { background: var(--panel-2); border-color: var(--accent); }
.shortener { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 20px; margin-bottom: 32px; }
.shortener label { display: block; color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; }
.shortener .row { display: flex; gap: 8px; }
.shortener input { flex: 1; background: var(--panel-2); border: 1px solid var(--border); border-radius: 6px; padding: 10px 12px; color: var(--text); font: inherit; }
.shortener input:focus { outline: none; border-color: var(--accent); }
.shortener button { background: var(--accent); color: var(--bg); border: 0; border-radius: 6px; padding: 10px 18px; font-weight: 600; cursor: pointer; }
.shortener button:hover { opacity: 0.9; }
.shortener .result { margin-top: 12px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; color: var(--accent); word-break: break-all; }
.shortener .result.error { color: #f87171; }
.section-title { font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 28px 0 12px; }
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; }
.card { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; }
.card .label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; }
.card .value { color: var(--text); font-size: 22px; font-weight: 600; margin-top: 4px; font-variant-numeric: tabular-nums; }
.top-list { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 4px 0; margin-top: 10px; }
.top-row { display: flex; justify-content: space-between; padding: 10px 16px; border-top: 1px solid var(--border); font-size: 14px; }
.top-row:first-child { border-top: none; }
.top-row .path { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--text); }
.top-row .hits { color: var(--accent); font-variant-numeric: tabular-nums; }
/* WOW stats */
.hero-stats {display: grid;grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));gap: 14px;margin: 0 0 36px;}

.hero-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #161b22 0%, #12161c 100%);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 18px;
}

.hero-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at top right, rgba(110,231,183,.12), transparent 45%);
  pointer-events: none;
}

.hero-kicker {
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: .08em;
  font-size: 11px;
  margin-bottom: 8px;
}

.hero-value {
  font-size: 34px;
  line-height: 1;
  font-weight: 800;
  letter-spacing: -0.04em;
  color: var(--accent);
  font-variant-numeric: tabular-nums;
}

.hero-sub {
  margin-top: 8px;
  color: var(--muted);
  font-size: 13px;
}

.bench {
  margin: 34px 0;
  background: linear-gradient(180deg, #14181d 0%, #101419 100%);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 22px;
}

.bench-head {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: flex-start;
  margin-bottom: 18px;
}

.bench-title {
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.03em;
}

.bench-title span {
  color: var(--accent);
}

.bench-copy {
  color: var(--muted);
  max-width: 520px;
  font-size: 14px;
}

.bench-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 12px;
}

.bench-box {
  background: rgba(255,255,255,.02);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 14px;
}

.bench-box .k {
  color: var(--muted);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .06em;
}

.bench-box .v {
  margin-top: 6px;
  font-size: 28px;
  font-weight: 800;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}

.bench-box .d {
  margin-top: 4px;
  color: var(--muted);
  font-size: 12px;
}

.highlight {
  color: var(--accent);
  font-weight: 700;
}
footer { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--border); color: var(--muted); font-size: 13px; }
footer a { color: var(--accent); text-decoration: none; }
footer a:hover { text-decoration: underline; }
code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; background: var(--panel-2); padding: 1px 6px; border-radius: 4px; font-size: 13px; }
</style>
</head>
<body>
<h1>1kb<span class='dot'>.uz</span></h1>
<p class='lede'>A URL shortener served by a JWC program. Same one-file source builds the API and this page.</p>

<div class='hero-stats'>
  <div class='hero-card'>
    <div class='hero-kicker'>Throughput</div>
    <div class='hero-value'>14.6k</div>
    <div class='hero-sub'>requests / second under load</div>
  </div>

  <div class='hero-card'>
    <div class='hero-kicker'>Average latency</div>
    <div class='hero-value'>11ms</div>
    <div class='hero-sub'>across 2.2M+ requests</div>
  </div>

  <div class='hero-card'>
    <div class='hero-kicker'>Reliability</div>
    <div class='hero-value'>99.96%</div>
    <div class='hero-sub'>successful responses</div>
  </div>

  <div class='hero-card'>
    <div class='hero-kicker'>Stack</div>
    <div class='hero-value'>JWC</div>
    <div class='hero-sub'>custom language + native HTTP server</div>
  </div>
</div>

<div class='shortener'>
  <label for='url'>Shorten a URL</label>
  <div class='row'>
    <input id='url' type='url' placeholder='https://example.com/very/long/path'>
    <button id='go'>Shorten</button>
  </div>
  <div id='out' class='result'></div>
</div>

<div class='links'>
  <a href='https://github.com/Nodirbek-Abdulaxadov/jwc-shortener'>Source code</a>
  <a href='https://jwc.1kb.uz'>JWC language</a>
  <a href='/docs'>API docs</a>
  <a href='/openapi.json'>OpenAPI</a>
</div>

<div class='bench'>
  <div class='bench-head'>
    <div>
      <div class='bench-title'>
        Benchmarked at <span>14,595 req/sec</span>
      </div>
      <div class='bench-copy'>
        1kb.uz is stress-tested using JMeter against a real PostgreSQL-backed deployment.
        Even under sustained concurrent traffic the API maintained single-digit millisecond latency.
      </div>
    </div>
  </div>

  <div class='bench-grid'>
    <div class='bench-box'>
      <div class='k'>GET /healthz</div>
      <div class='v'>2ms</div>
      <div class='d'>~2919 req/sec</div>
    </div>

    <div class='bench-box'>
      <div class='k'>POST /api/links</div>
      <div class='v'>17ms</div>
      <div class='d'>URL creation</div>
    </div>

    <div class='bench-box'>
      <div class='k'>Redirect</div>
      <div class='v'>22ms</div>
      <div class='d'>302 redirect latency</div>
    </div>

    <div class='bench-box'>
      <div class='k'>Error rate</div>
      <div class='v'>0.04%</div>
      <div class='d'>during stress test</div>
    </div>
  </div>
</div>

<div class='section-title'>Live stats</div>
<div id='stats' class='cards'>
  <div class='card'><div class='label'>Total requests</div><div class='value' id='m-total'>-</div></div>
  <div class='card'><div class='label'>Last 24h</div><div class='value' id='m-24h'>-</div></div>
  <div class='card'><div class='label'>p50</div><div class='value' id='m-p50'>-</div></div>
  <div class='card'><div class='label'>p95</div><div class='value' id='m-p95'>-</div></div>
  <div class='card'><div class='label'>p99</div><div class='value' id='m-p99'>-</div></div>
</div>

<div class='section-title'>Top endpoints</div>
<div id='top' class='top-list'>
  <div class='top-row'><span class='path'>loading...</span><span class='hits'></span></div>
</div>

<footer>
  Made with JWC &mdash; see <a href='https://github.com/Nodirbek-Abdulaxadov/jwc-lang'>github.com/Nodirbek-Abdulaxadov/jwc-lang</a>.
  Source: <a href='https://github.com/Nodirbek-Abdulaxadov/jwc-shortener'>github.com/Nodirbek-Abdulaxadov/jwc-shortener</a>.
</footer>

<script>
(function () {
  function fmtNum(n) { if (n == null) return '-'; if (n >= 1000000) return (n / 1000000).toFixed(1) + 'M'; if (n >= 1000) return (n / 1000).toFixed(1) + 'k'; return String(n); }
  function fmtMs(n) { return (n == null ? '-' : n + ' ms'); }
  function setText(id, v) { var el = document.getElementById(id); if (el) el.textContent = v; }

  var input = document.getElementById('url');
  var btn   = document.getElementById('go');
  var out   = document.getElementById('out');
  function shorten() {
    var url = input.value.trim();
    if (!url) { out.className = 'result error'; out.textContent = 'paste a URL first'; return; }
    out.className = 'result'; out.textContent = 'shortening...';
    fetch('/api/links', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ url: url }) })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); })
      .then(function (res) {
        if (!res.ok) { out.className = 'result error'; out.textContent = (res.body && res.body.error) || 'failed'; return; }
        out.className = 'result'; out.textContent = res.body.short;
      })
      .catch(function () { out.className = 'result error'; out.textContent = 'network error'; });
  }
  btn.addEventListener('click', shorten);
  input.addEventListener('keydown', function (e) { if (e.key === 'Enter') shorten(); });

  fetch('/api/v1/stats', { headers: { 'accept': 'application/json' } })
    .then(function (r) { return r.json(); })
    .then(function (s) {
      setText('m-total', fmtNum(s.total));
      setText('m-24h',   fmtNum(s.last_24h));
      setText('m-p50',   fmtMs(s.p50_ms));
      setText('m-p95',   fmtMs(s.p95_ms));
      setText('m-p99',   fmtMs(s.p99_ms));
      var top = document.getElementById('top');
      top.innerHTML = '';
      var rows = (s.top_endpoints || []);
      if (rows.length === 0) {
        var empty = document.createElement('div'); empty.className = 'top-row';
        var ep = document.createElement('span'); ep.className = 'path'; ep.textContent = '(no traffic yet)';
        var eh = document.createElement('span'); eh.className = 'hits';
        empty.appendChild(ep); empty.appendChild(eh); top.appendChild(empty);
        return;
      }
      rows.forEach(function (row) {
        var div = document.createElement('div'); div.className = 'top-row';
        var p = document.createElement('span'); p.className = 'path'; p.textContent = row.path;
        var h = document.createElement('span'); h.className = 'hits'; h.textContent = fmtNum(row.hits);
        div.appendChild(p); div.appendChild(h);
        top.appendChild(div);
      });
    })
    .catch(function () { setText('m-total', '?'); });
})();
</script>
</body>
</html>";
}

function landing_docs(): string {
    return r"<!DOCTYPE html>
<html lang='en'>
<head>
<meta charset='utf-8'>
<title>1kb.uz API — Swagger UI</title>
<link rel='stylesheet' href='https://unpkg.com/swagger-ui-dist@5/swagger-ui.css'>
<style>body { margin: 0; }</style>
</head>
<body>
<div id='swagger-ui'></div>
<script src='https://unpkg.com/swagger-ui-dist@5/swagger-ui-bundle.js'></script>
<script>
window.onload = function () {
  window.ui = SwaggerUIBundle({
    url: '/openapi.json',
    dom_id: '#swagger-ui',
    deepLinking: true,
    presets: [SwaggerUIBundle.presets.apis],
    layout: 'BaseLayout'
  });
};
</script>
</body>
</html>";
}

function openapi_spec(): string {
    // JWC object literals only allow bare identifier keys (no "/") and no
    // array literals — hand-write the OpenAPI as a string. Swagger UI
    // validates it as JSON on page load.
    return "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"1kb.uz API\",\"version\":\"0.1.0\",\"description\":\"URL shortener + landing, served by a JWC program.\"},\"servers\":[{\"url\":\"https://1kb.uz\"}],\"paths\":{\"/\":{\"get\":{\"summary\":\"Landing page (HTML)\",\"responses\":{\"200\":{\"description\":\"HTML landing page\"}}}},\"/healthz\":{\"get\":{\"summary\":\"Liveness probe\",\"responses\":{\"200\":{\"description\":\"ok\"}}}},\"/api/links\":{\"post\":{\"summary\":\"Create a short link\",\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"required\":[\"url\"],\"properties\":{\"url\":{\"type\":\"string\",\"format\":\"uri\",\"minLength\":8,\"maxLength\":2048}}}}}},\"responses\":{\"201\":{\"description\":\"Created — returns short code + URL\"},\"400\":{\"description\":\"Validation failed\"}}}},\"/api/links/{code}\":{\"get\":{\"summary\":\"Look up a short link\",\"parameters\":[{\"name\":\"code\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"responses\":{\"200\":{\"description\":\"Link metadata\"},\"404\":{\"description\":\"No such link\"}}}},\"/{code}\":{\"get\":{\"summary\":\"Redirect to the original URL\",\"parameters\":[{\"name\":\"code\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"responses\":{\"302\":{\"description\":\"Redirect\"},\"404\":{\"description\":\"No such link\"}}}},\"/api/v1/stats\":{\"get\":{\"summary\":\"Aggregate traffic stats\",\"responses\":{\"200\":{\"description\":\"Stats payload\"},\"429\":{\"description\":\"Rate limited (60 req / 60s per IP)\"}}}},\"/openapi.json\":{\"get\":{\"summary\":\"This OpenAPI document\",\"responses\":{\"200\":{\"description\":\"OpenAPI 3.0 JSON\"}}}},\"/docs\":{\"get\":{\"summary\":\"Swagger UI\",\"responses\":{\"200\":{\"description\":\"Interactive API docs (HTML)\"}}}}}}";
}
