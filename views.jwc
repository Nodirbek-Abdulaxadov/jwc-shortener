// HTML for the public landing page (`/`).
//
// Every `.jwc` file in the project merges into one flat program, so this is
// callable from `main.jwc` with no import.
//
// House rule for this file: **the HTML and JS never contain a double
// quote.** A raw string (`r"..."`) ends at the first `"`, so attributes and
// JS string literals are single-quoted throughout. Runtime JSON is fine —
// it is not source text.
//
// The signed-in experience is NOT here: `web/` is an Angular app (PrimeNG,
// OIDC via angular-auth-oidc-client) served separately, and this page links
// to it through `admin_url()`.
//
// Translation is client-side: every translatable node carries `data-i18n`
// and the dictionary lives in the page. It shares the `app-lang`
// localStorage key with the Angular panel, so switching the language in
// either place carries over to the other.

function base_css(): string {
    return r"
:root {
  --bg:#0b0d10; --panel:#14181d; --panel2:#1b2027; --text:#e6e8eb;
  --muted:#8a9099; --accent:#6ee7b7; --border:#232830;
}
* { box-sizing:border-box; }
html,body { margin:0; padding:0; background:var(--bg); color:var(--text); }
body { font:15px/1.55 ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,sans-serif; }
a { color:var(--accent); text-decoration:none; }
a:hover { text-decoration:underline; }
.wrap { max-width:960px; margin:0 auto; padding:28px 22px 64px; }
header.top { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:36px; }
.brand { display:flex; align-items:center; gap:10px; font-weight:650; letter-spacing:-.01em; }
.dot { width:22px; height:22px; border-radius:6px; background:var(--accent); display:inline-block; }
.top-right { display:flex; align-items:center; gap:10px; }
.lang { display:flex; border:1px solid var(--border); border-radius:8px; overflow:hidden; }
.lang button { background:transparent; color:var(--muted); border:0; padding:6px 10px; font:inherit;
               font-size:13px; cursor:pointer; }
.lang button.on { background:var(--panel2); color:var(--text); }
.btn { display:inline-block; border:1px solid var(--border); background:var(--panel2); color:var(--text);
       padding:9px 16px; border-radius:9px; font:inherit; font-weight:550; cursor:pointer; }
.btn:hover { border-color:var(--accent); text-decoration:none; }
.btn.primary { background:var(--accent); color:#08130e; border-color:var(--accent); }
.btn.ghost { background:transparent; }
.card { background:var(--panel); border:1px solid var(--border); border-radius:14px; padding:22px; }
h1 { font-size:38px; line-height:1.15; letter-spacing:-.02em; margin:0 0 12px; }
h2 { font-size:19px; margin:0 0 14px; letter-spacing:-.01em; }
h3 { font-size:15px; margin:0 0 6px; }
p.lead { color:var(--muted); font-size:17px; margin:0 0 26px; max-width:58ch; }
input { width:100%; padding:10px 12px; border-radius:9px; border:1px solid var(--border);
        background:var(--panel2); color:var(--text); font:inherit; }
input:focus { outline:none; border-color:var(--accent); }
.row { display:flex; gap:10px; flex-wrap:wrap; }
.row > * { flex:1 1 220px; }
.row .grow2 { flex:2 1 340px; }
.muted { color:var(--muted); }
.small { font-size:13px; }
.mono { font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; }
.grid3 { display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:14px; margin:26px 0; }
.stat { background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:16px 18px; }
.stat .n { font-size:26px; font-weight:650; letter-spacing:-.02em; }
.stat .k { color:var(--muted); font-size:13px; margin-top:2px; }
.msg { padding:11px 14px; border-radius:9px; margin:14px 0 0; font-size:14px; display:none; }
.msg.err { background:#2a1618; border:1px solid #542a2c; color:#fca5a5; }
.msg.ok { background:#122019; border:1px solid #215045; color:var(--accent); }
.msg.show { display:block; }
footer { margin-top:44px; padding-top:20px; border-top:1px solid var(--border); color:var(--muted); font-size:13px; }
.feat { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:16px; margin:8px 0 4px; }
.feat p { margin:0; color:var(--muted); font-size:14px; }
";
}

// uz first because the audience is uz-first; the switch defaults to whatever
// the panel last stored, else the browser language, else en.
function landing_i18n_json(): string {
    return r"{
  'en': {
    'cta_enter': 'Sign in',
    'hero_1': 'Long links,',
    'hero_2': 'six characters.',
    'lead': 'Bijective code generation, one Redis round-trip per redirect, and OIDC auth through musanna-platform. All of it written in JWC.',
    'cta_panel': 'Open the panel',
    'cta_check': 'Check a link',
    'stat_links': 'links',
    'stat_clicks': 'redirects',
    'stat_today': 'today',
    'check_title': 'Check a link',
    'check_help': 'Paste a code or a full short URL and see where it goes without opening it.',
    'check_btn': 'Check',
    'check_missing': 'No such link.',
    'check_error': 'Something went wrong.',
    'check_hits': 'redirects',
    'f1_title': 'Collision-free codes',
    'f1_body': 'Codes come from a bijective permutation of a sequence: no retries, no guessable order.',
    'f2_title': 'One round-trip',
    'f2_body': 'A redirect is a single Redis script: cache read, hit counter and flush claim together.',
    'f3_title': 'Your links',
    'f3_body': 'Every link belongs to an account: quotas, deletion and statistics live in the panel.',
    'footer_built': 'Written in JWC'
  },
  'uz': {
    'cta_enter': 'Kirish',
    'hero_1': 'Uzun havolalarni',
    'hero_2': 'olti belgiga siqing.',
    'lead': 'Bijektiv kod generatsiyasi, bitta Redis round-trip bilan redirect, va musanna-platform orqali OIDC autentifikatsiya. Hammasi JWC tilida.',
    'cta_panel': 'Panelga kirish',
    'cta_check': 'Havolani tekshirish',
    'stat_links': 'havola',
    'stat_clicks': 'o’tish',
    'stat_today': 'bugungi o’tish',
    'check_title': 'Havolani tekshirish',
    'check_help': 'Kodni yoki to’liq qisqa havolani kiriting va qayerga olib borishini ochmasdan ko’ring.',
    'check_btn': 'Tekshirish',
    'check_missing': 'Bunday havola topilmadi.',
    'check_error': 'Xatolik yuz berdi.',
    'check_hits': 'ta o’tish',
    'f1_title': 'To’qnashuvsiz kodlar',
    'f1_body': 'Kod ketma-ketlikning bijektiv almashtirishidan olinadi: retry ham, taxmin qilinadigan tartib ham yo’q.',
    'f2_title': 'Bitta round-trip',
    'f2_body': 'Redirect Redis’da bitta Lua skript: kesh o’qish, hit hisoblash va flush navbati birga.',
    'f3_title': 'Sizning havolalaringiz',
    'f3_body': 'Har havola egasiga bog’lanadi: kvota, o’chirish va statistika panelda.',
    'footer_built': 'JWC tilida yozilgan'
  }
}";
}

function landing_html(): string {
    return r"<!DOCTYPE html>
<html lang='uz'>
<head>
<meta charset='utf-8'>
<meta name='viewport' content='width=device-width, initial-scale=1'>
<title>jwc-shortener</title>
<meta name='description' content='URL shortener written in JWC: bijective codes, Redis cache, OIDC auth.'>
<meta name='theme-color' content='#0b0d10'>
<link rel='icon' type='image/svg+xml' href='data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2032%2032%22%3E%3Crect%20width=%2232%22%20height=%2232%22%20rx=%227%22%20fill=%22%230b0d10%22/%3E%3Ccircle%20cx=%2216%22%20cy=%2216%22%20r=%226%22%20fill=%22%236ee7b7%22/%3E%3C/svg%3E'>
<style>" + base_css() + r"</style>
</head>
<body>
<div class='wrap'>

  <header class='top'>
    <span class='brand'><span class='dot'></span> jwc-shortener</span>
    <span class='top-right'>
      <span class='lang'>
        <button type='button' data-lang='uz'>UZ</button>
        <button type='button' data-lang='en'>EN</button>
      </span>
      <a class='btn primary' id='enter' data-i18n='cta_enter'></a>
    </span>
  </header>

  <h1><span data-i18n='hero_1'></span><br><span data-i18n='hero_2'></span></h1>
  <p class='lead' data-i18n='lead'></p>

  <div class='row' style='max-width:520px'>
    <a class='btn primary' id='enter2' data-i18n='cta_panel'></a>
    <a class='btn ghost' href='#tekshir' data-i18n='cta_check'></a>
  </div>

  <div class='grid3'>
    <div class='stat'><div class='n' id='s-links'>0</div><div class='k' data-i18n='stat_links'></div></div>
    <div class='stat'><div class='n' id='s-clicks'>0</div><div class='k' data-i18n='stat_clicks'></div></div>
    <div class='stat'><div class='n' id='s-today'>0</div><div class='k' data-i18n='stat_today'></div></div>
  </div>

  <div class='card' id='tekshir'>
    <h2 data-i18n='check_title'></h2>
    <p class='muted small' style='margin-top:-8px' data-i18n='check_help'></p>
    <div class='row'>
      <input id='code' class='grow2 mono' placeholder='0xOdkp' autocomplete='off'>
      <button class='btn primary' id='check' style='flex:0 0 auto' data-i18n='check_btn'></button>
    </div>
    <div class='msg' id='out'></div>
  </div>

  <div class='feat' style='margin-top:32px'>
    <div class='card'>
      <h3 data-i18n='f1_title'></h3>
      <p data-i18n='f1_body'></p>
    </div>
    <div class='card'>
      <h3 data-i18n='f2_title'></h3>
      <p data-i18n='f2_body'></p>
    </div>
    <div class='card'>
      <h3 data-i18n='f3_title'></h3>
      <p data-i18n='f3_body'></p>
    </div>
  </div>

  <footer>
    <span data-i18n='footer_built'></span> &middot;
    <a href='https://github.com/Nodirbek-Abdulaxadov/jwc-lang'>jwc-lang</a> &middot;
    <a href='/healthz'>healthz</a> &middot;
    <a href='/metrics'>metrics</a>
  </footer>

</div>
<script>
(function () {
  var PANEL = '" + admin_url() + r"';
  var DICT = " + landing_i18n_json() + r";
  var LANG_KEY = 'app-lang';

  document.getElementById('enter').href = PANEL;
  document.getElementById('enter2').href = PANEL;

  function pick() {
    var saved = localStorage.getItem(LANG_KEY);
    if (saved && DICT[saved]) { return saved; }
    return (navigator.language || 'en').slice(0, 2) === 'uz' ? 'uz' : 'en';
  }

  var lang = pick();

  function t(key) {
    return (DICT[lang] && DICT[lang][key]) || (DICT['en'] && DICT['en'][key]) || key;
  }

  function apply() {
    document.documentElement.lang = lang;
    var nodes = document.querySelectorAll('[data-i18n]');
    for (var i = 0; i < nodes.length; i++) {
      nodes[i].textContent = t(nodes[i].getAttribute('data-i18n'));
    }
    var buttons = document.querySelectorAll('[data-lang]');
    for (var j = 0; j < buttons.length; j++) {
      buttons[j].className = buttons[j].getAttribute('data-lang') === lang ? 'on' : '';
    }
  }

  var langButtons = document.querySelectorAll('[data-lang]');
  for (var k = 0; k < langButtons.length; k++) {
    langButtons[k].addEventListener('click', function () {
      lang = this.getAttribute('data-lang');
      // Same key the Angular panel persists, so the choice carries over.
      localStorage.setItem(LANG_KEY, lang);
      apply();
    });
  }
  apply();

  var out = document.getElementById('out');
  function show(kind, text) {
    out.className = 'msg show ' + kind;
    out.textContent = text;
  }

  fetch('/api/stats').then(function (r) { return r.json(); }).then(function (s) {
    document.getElementById('s-links').textContent = s.links;
    document.getElementById('s-clicks').textContent = s.clicks;
    document.getElementById('s-today').textContent = s.today;
  }).catch(function () {});

  function check() {
    var raw = document.getElementById('code').value.trim();
    if (!raw) { return; }
    var parts = raw.split('/');
    var code = parts[parts.length - 1];
    fetch('/api/links/' + encodeURIComponent(code)).then(function (r) {
      if (r.status === 404) { show('err', t('check_missing')); return null; }
      return r.json();
    }).then(function (d) {
      if (!d) { return; }
      show('ok', d.url + '  (' + d.hits + ' ' + t('check_hits') + ')');
    }).catch(function () { show('err', t('check_error')); });
  }
  document.getElementById('check').addEventListener('click', check);
  document.getElementById('code').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { check(); }
  });
})();
</script>
</body>
</html>";
}
