// qr-lite — QR codes via barcodeapi.org. Only `qr_img_tag` is exported.

private function qr_encode(text: string): string {
    let out = "";
    for ch in split(text, "") {
        if (ch == "") {
            // split("", "") returns leading/trailing empties — skip them.
        }
        if (ch == " ") { out = out + "%20"; }
        if (ch == "#") { out = out + "%23"; }
        if (ch == "?") { out = out + "%3F"; }
        if (ch == "&") { out = out + "%26"; }
        if (ch == "/") { out = out + "%2F"; }
        if (ch == ":") { out = out + "%3A"; }
        if (
            ch != "" and
            ch != " " and
            ch != "#" and
            ch != "?" and
            ch != "&" and
            ch != "/" and
            ch != ":"
        ) {
            out = out + ch;
        }
    }
    return out;
}

private function qr_svg_url(text: string): string {
    let encoded = qr_encode(text);
    return "https://barcodeapi.org/api/qr/" + encoded + "?format=svg";
}

public function qr_img_tag(text: string): string {
    let url = qr_svg_url(text);
    return "<img src='" + url + "' alt='QR Code'/>";
}
